---
import Layout from "@/layouts/Layout.astro";
import Header from "@/landing/components/Header.astro";
import Hero from "@/landing/components/Hero.astro";
import Pad from "@/landing/components/Pad.astro";
import Cards from "@/landing/components/Cards.astro";
import Features from "@/landing/components/Features.astro";
import FinalCta from "@/landing/components/FinalCta.astro";
import Faq from "@/landing/components/Faq.astro";
import Footer from "@/landing/components/Footer.astro";
import { SITE } from "@/config";
import { LANDING_QUESTIONS } from "@/landing/topics";
import "@/landing/landing.css";

export const prerender = true;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${SITE.url}/#app`,
  name: SITE.name,
  alternateName: "zketch sketchpad",
  url: `${SITE.url}/`,
  description: SITE.description,
  applicationCategory: "DesignApplication",
  applicationSubCategory: "Drawing",
  featureList: [
    "Online sketchpad with pressure-sensitive pencil, ink and marker",
    "36 textured brushes including watercolor, gouache, oil and charcoal",
    "Hand-drawn flowcharts and diagrams with arrows that stay attached to shapes",
    "Layers",
    "Replay a drawing stroke by stroke, and download the replay of a shared drawing as a video",
    "Share links and embeds",
    "PNG and JPG export",
    "Saves drawings in the browser with no account",
  ],
  isAccessibleForFree: true,
  operatingSystem: "Any",
  browserRequirements: "Requires a modern web browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  inLanguage: "en",
  creator: { "@type": "Person", name: SITE.author, url: SITE.authorUrl },
};
---

<Layout jsonLd={jsonLd} zoomable appTheme={false}>
  <div class="lp" data-landing>
    <script is:inline>try{if(localStorage.getItem("zketch-landing-theme")==="dark")document.documentElement.dataset.lpTheme="dark"}catch(e){}</script>
    <Header />
    <main>
      <Hero />
      <Pad />
      <Cards />
      <Features />
      <Faq questions={LANDING_QUESTIONS} />
      <FinalCta />
    </main>
    <Footer />
  </div>
</Layout>
