---
import ZIcon from "./ZIcon.astro";

const slots = [
  { x: "5%", y: "7%", r: "-5deg", s: 1 },
  { x: "80%", y: "5%", r: "5deg", s: 1 },
  { x: "4%", y: "64%", r: "4deg", s: 0.95 },
  { x: "79%", y: "66%", r: "-4deg", s: 1 },
  { x: "14%", y: "36%", r: "3deg", s: 0.85 },
  { x: "87%", y: "35%", r: "-3deg", s: 0.85 },
];
---

<section class="lp-hero" data-hero aria-labelledby="lp-title">
  <div class="lp-hero-copy">
    <p class="lp-tape">free · no sign-up · nothing to install</p>
    <h1 id="lp-title" class="lp-title" data-headline>
      Doodle, diagram <span class="lp-amp">&amp;</span> <span class="lp-paint">paint</span>, right in your browser.
    </h1>
    <p class="lp-joke" data-joke hidden></p>
    <p class="lp-sub">
      zketch is a free drawing app with real textured brushes, sketchy diagrams and layers. Your drawings stay on your device.
    </p>
    <div class="lp-actions">
      <a href="/draw" class="lp-btn lp-desktop-only" data-cta>start drawing <span aria-hidden="true">→</span></a>
      <a href="/vault" class="lp-btn lp-btn-ghost lp-desktop-only" data-vault-link>your drawings</a>
      <p class="lp-phone-note lp-phone-only">zketch works on tablets and computers. open zketch.zerro.dev there.</p>
    </div>
    <p class="lp-hint lp-desktop-only" aria-hidden="true">psst, the doodles are clickable</p>
  </div>
  <div class="lp-slots">
    {
      slots.map((s, i) => (
        <button
          type="button"
          class="lp-slot"
          data-slot={i}
          data-desktop-only={i >= 4 ? "" : undefined}
          style={`--x:${s.x};--y:${s.y};--r:${s.r};--s:${s.s}`}
          aria-label="swap this doodle for a new one"
        >
          <canvas aria-hidden="true" />
        </button>
      ))
    }
  </div>
  <template data-eraser-icon><ZIcon name="eraser" size={30} /></template>
  <template data-pen-icon><ZIcon name="pencil" size={34} /></template>
  <div class="lp-pens" data-pens aria-hidden="true"></div>
</section>

<script>
  import { mountHero } from "../hero";
  import { mountPens, springButton } from "../pens";
  import { mountEggs } from "../eggs";

  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root) {
    mountHero(root);
    const cta = root.querySelector<HTMLElement>(".lp-hero-copy [data-cta]");
    mountPens(root, cta);
    mountEggs(root);
    for (const el of document.querySelectorAll<HTMLElement>("[data-cta]")) {
      if (el === cta) continue;
      const s = springButton(el);
      el.addEventListener("pointerenter", () => s.kick(-1.4));
    }
  }
</script>
