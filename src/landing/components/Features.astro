---
import PencilLine from "./PencilLine.astro";

const features = [
  {
    id: "mini-diagram",
    title: "sketchy diagrams that keep up.",
    link: { href: "/flowchart-maker", label: "more on hand-drawn flowcharts" },
    body: "Flowcharts, mind maps and whiteboard sketches: boxes, diamonds, circles and arrows with a hand-drawn look. Arrows stick to the shapes they point at, so moving a box drags its arrows along. Label anything with text.",
  },
  {
    id: "brush-jar",
    title: "real textures, not just lines.",
    link: { href: "/brushes", label: "see all 36 brushes" },
    body: "Pencil with paper grain, watercolor that pools, gouache, crayon, charcoal and oil, plus nature brushes that plant a row of pine trees or a meadow in one stroke.",
  },
  {
    id: "paper-stack",
    title: "layers, like a grown-up app.",
    body: "Put sketch, ink and color on their own layers. Hide them, lock them, reorder them, or focus on one while the rest fades back.",
  },
  {
    id: "layout",
    title: "your desk, your layout.",
    body: "Pick Bottom deck, Sidebars or Simple, which is one floating toolbar with number keys for tools, like a whiteboard. Or drag any panel by its grip to another side and keep it there. Light or dark, your own accent colour, and a stylus-only mode so a resting palm never paints.",
  },
  {
    id: "film-replay",
    title: "watch it draw itself.",
    link: { href: "/drawing-timelapse", label: "make a drawing timelapse" },
    body: "zketch remembers every stroke, so any drawing can replay stroke by stroke, at the speed you like, and a shared drawing can be saved as a timelapse video. This page is doing it right now.",
  },
  {
    id: "share-arrow",
    title: "send it anywhere.",
    body: "Share a link anyone can open, embed the replay on your site, or export your drawing as PNG, JPG or SVG.",
  },
  {
    id: "padlock",
    title: "your drawings never leave your browser.",
    body: "No account, and nothing is uploaded unless you share it. Everything is saved on your device, in the browser you drew in.",
    aside: "we can't see your drawings. we tried.",
  },
];
---

<section class="lp-section lp-features" aria-labelledby="lp-features-title">
  <PencilLine />
  <div class="lp-section-head">
    <h2 id="lp-features-title">everything you need to think on paper.</h2>
    <p>Quick doodles, tidy-ish diagrams and proper paintings, all in one app.</p>
  </div>
  <ol class="lp-feature-list">
    {
      features.map((f, i) => (
        <li class:list={["lp-feature", { "lp-feature-flip": i % 2 === 1 }]}>
          <div class="lp-feature-copy">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            {f.link && <p class="lp-more"><a href={f.link.href}>{f.link.label} <span aria-hidden="true">→</span></a></p>}
            {f.aside && <p class="lp-aside">{f.aside}</p>}
          </div>
          <div class="lp-scrap lp-feature-art" data-margin={f.id} style={`--r:${i % 2 ? 2.5 : -2.5}deg`} aria-hidden="true">
            <canvas />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { mountMargins } from "../margins";
  import { mountPencilLine } from "../line";

  const root = document.querySelector<HTMLElement>(".lp-features");
  if (root) {
    mountMargins(root);
    mountPencilLine(root);
  }
</script>
