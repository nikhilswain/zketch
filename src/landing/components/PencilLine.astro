---
import ZIcon from "./ZIcon.astro";
---

<div class="lp-pencil-clip" data-pencil-clip aria-hidden="true">
<svg class="lp-pencil-line" viewBox="0 0 100 1000" preserveAspectRatio="none">
  <path
    d="M50 0 C 18 60, 82 120, 50 170 S 16 260, 52 330 S 86 420, 48 500 S 14 590, 50 670 S 84 760, 50 840 S 22 930, 50 1000"
    pathLength="1"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
</svg>
</div>
<span class="lp-pencil-tip" data-pencil-tip aria-hidden="true" hidden><ZIcon name="pencil" size={30} /></span>
